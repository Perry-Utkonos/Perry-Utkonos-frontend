@@ -0,0 +1,48 @@
+namespace ChatApp.Api.Controllers;
+
+using ChatApp.Application.Abstractions;
+using ChatApp.Application.Dtos;
+using ChatApp.Domain.Exceptions;
+using ChatApp.Infrastructure.Persistence;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+[Authorize]
+[ApiController]
+[Route("api/likes")]
+public class LikesController(ChatDbContext db, ICurrentUserProvider current, IConversationService conversations) : ControllerBase
+{
+    [HttpGet]
+    public async Task<LikesDto> List(CancellationToken ct)
+    {
+        var id = current.UserId;
+        return new(await db.Likes.Where(x => x.UserId == id).Select(x => x.TargetUserId).ToArrayAsync(ct),
+            await db.Likes.Where(x => x.TargetUserId == id).Select(x => x.UserId).ToArrayAsync(ct));
+    }
+
+    [HttpPost]
+    public async Task<LikeResult> Like([FromBody] LikeRequest req, CancellationToken ct)
+    {
+        var id = current.UserId;
+        if (id == req.TargetUserId) throw new ValidationException("Cannot like yourself.");
+        if (!await db.Users.AnyAsync(x => x.Id == req.TargetUserId && x.IsActive, ct))
+            throw new NotFoundException("Profile not found.");
+        // Serialize both directions of this pair so concurrent reciprocal likes create one match.
+        await using var transaction = await db.Database.BeginTransactionAsync(ct);
+        var pair = Domain.Entities.Conversation.OrderPair(id, req.TargetUserId);
+        await db.Database.ExecuteSqlInterpolatedAsync($"SELECT pg_advisory_xact_lock(hashtextextended({pair.Item1.ToString() + pair.Item2.ToString()}, 0))", ct);
+        await db.Database.ExecuteSqlInterpolatedAsync($"INSERT INTO likes (user_id, target_user_id, created_at) VALUES ({id}, {req.TargetUserId}, {DateTime.UtcNow}) ON CONFLICT DO NOTHING", ct);
+        var match = await db.Likes.AnyAsync(x => x.UserId == req.TargetUserId && x.TargetUserId == id, ct);
+        Guid? conversationId = match ? (await conversations.CreateOrGetAsync(id, req.TargetUserId, ct)).Id : null;
+        await transaction.CommitAsync(ct);
+        return new(req.TargetUserId, match, conversationId);
+    }
+
+    [HttpDelete("{targetUserId:guid}")]
+    public async Task<IActionResult> Unlike(Guid targetUserId, CancellationToken ct)
+    {
+        await db.Likes.Where(x => x.UserId == current.UserId && x.TargetUserId == targetUserId).ExecuteDeleteAsync(ct);
+        return NoContent();
+    }
+}
