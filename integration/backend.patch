new file mode 100644
index 0000000..ca9399d
--- /dev/null
+++ b/src/ChatApp.Api/Controllers/ProfilesController.cs
@@ -0,0 +1,100 @@
+namespace ChatApp.Api.Controllers;
+
+using System.Text.Json;
+using ChatApp.Application.Abstractions;
+using ChatApp.Application.Dtos;
+using ChatApp.Domain.Entities;
+using ChatApp.Domain.Exceptions;
+using ChatApp.Infrastructure.Persistence;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+[Authorize]
+[ApiController]
+public class ProfilesController(ChatDbContext db, ICurrentUserProvider current) : ControllerBase
+{
+    [HttpGet("api/me")]
+    public async Task<ProfileDto> Me(CancellationToken ct)
+        => UserMapping.ToProfileDto(await CurrentUser(ct));
+
+    [HttpPatch("api/me")]
+    public async Task<ProfileDto> Update([FromBody] JsonElement body, CancellationToken ct)
+    {
+        if (body.ValueKind != JsonValueKind.Object) throw new ValidationException("Expected a profile object.");
+        UpdateProfileRequest req;
+        try { req = body.Deserialize<UpdateProfileRequest>(new JsonSerializerOptions(JsonSerializerDefaults.Web))!; }
+        catch (JsonException) { throw new ValidationException("Invalid profile fields or birth date."); }
+        var user = await CurrentUser(ct);
+        user.Profile ??= new UserProfile { UserId = user.Id, Metadata = "{}" };
+        var profile = user.Profile;
+        var metadata = UserMapping.Metadata(user);
+        bool Has(string field) => body.TryGetProperty(field, out _);
+
+        if (Has("displayName")) metadata = metadata with { DisplayName = Clean(req.DisplayName, 80) ?? user.Username };
+        if (Has("city")) metadata = metadata with { City = Clean(req.City, 120) ?? "" };
+        if (Has("sign")) metadata = metadata with { Sign = Clean(req.Sign, 40) };
+        if (Has("interests")) metadata = metadata with { Interests = CleanList(req.Interests, 30, 80) };
+        if (Has("goals")) metadata = metadata with { Goals = CleanList(req.Goals, 10, 120) };
+        if (Has("photos")) metadata = metadata with { Photos = CleanList(req.Photos, 10, 500, true) };
+        if (Has("bio")) profile.Bio = Clean(req.Bio, 500);
+        if (Has("gender")) profile.Gender = Clean(req.Gender, 16);
+        if (Has("avatarUrl")) profile.AvatarUrl = req.AvatarUrl is null ? null : PhotoUrl(req.AvatarUrl);
+        if (Has("birthDate"))
+        {
+            var today = DateOnly.FromDateTime(DateTime.UtcNow);
+            if (req.BirthDate is DateOnly birth && (birth > today.AddYears(-18) || birth < today.AddYears(-120)))
+                throw new ValidationException("Profile age must be between 18 and 120 years.");
+            profile.BirthDate = req.BirthDate;
+        }
+        profile.Metadata = UserMapping.Serialize(metadata);
+        user.UpdatedAt = DateTime.UtcNow;
+        await db.SaveChangesAsync(ct);
+        return UserMapping.ToProfileDto(user);
+    }
+
+    [HttpGet("api/profiles")]
+    public async Task<IReadOnlyList<ProfileDto>> List(CancellationToken ct, [FromQuery] int limit = 100, [FromQuery] int offset = 0)
+    {
+        if (limit is < 1 or > 200 || offset < 0) throw new ValidationException("Invalid profile page.");
+        var users = await db.Users.AsNoTracking().Include(x => x.Profile)
+            .Where(x => x.IsActive && x.Id != current.UserId)
+            .OrderByDescending(x => x.CreatedAt).ThenBy(x => x.Id).Skip(offset).Take(limit).ToListAsync(ct);
+        return users.Select(UserMapping.ToProfileDto).ToArray();
+    }
+
+    [HttpGet("api/profiles/{id:guid}")]
+    public async Task<ProfileDto> Get(Guid id, CancellationToken ct)
+    {
+        var user = await db.Users.AsNoTracking().Include(x => x.Profile)
+            .FirstOrDefaultAsync(x => x.Id == id && x.IsActive, ct)
+            ?? throw new NotFoundException("Profile not found.");
+        return UserMapping.ToProfileDto(user);
+    }
+
+    private async Task<User> CurrentUser(CancellationToken ct) => await db.Users.Include(x => x.Profile)
+        .FirstOrDefaultAsync(x => x.Id == current.UserId && x.IsActive, ct)
+        ?? throw new UnauthorizedAccessException("Account is unavailable.");
+
+    private static string? Clean(string? value, int max)
+    {
+        value = value?.Trim();
+        if (value?.Length > max) throw new ValidationException($"Profile text exceeds {max} characters.");
+        return string.IsNullOrEmpty(value) ? null : value;
+    }
+
+    private static string[] CleanList(string[]? values, int maxCount, int maxLength, bool urls = false)
+    {
+        if (values?.Length > maxCount) throw new ValidationException($"At most {maxCount} entries are allowed.");
+        return (values ?? []).Select(x => Clean(x, maxLength)).Where(x => x is not null)
+            .Select(x => urls ? PhotoUrl(x!) : x!).Distinct().ToArray();
+    }
+
+    private static string PhotoUrl(string value)
+    {
+        value = Clean(value, 500) ?? throw new ValidationException("Empty photo URL.");
+        if (value.StartsWith('/') && !value.StartsWith("//")) return value;
+        if (Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme is "https" or "http") return value;
+        throw new ValidationException("Photo must use an HTTP(S) URL or a local absolute path.");
+    }
+}
