+
+public record ProfileDto(
+    Guid Id, string Username, string DisplayName, string? AvatarUrl, DateTime? LastSeenAt,
+    int? Age, DateOnly? BirthDate, string City, string Bio, string[] Interests,
+    string? Sign, string[] Photos, string[] Goals, string? Gender);
+
+public record UpdateProfileRequest(
+    string? DisplayName, DateOnly? BirthDate, string? City, string? Bio,
+    string[]? Interests, string? Sign, string[]? Photos, string[]? Goals,
+    string? Gender, string? AvatarUrl);
+
+public record LikeRequest(Guid TargetUserId);
+public record LikeResult(Guid TargetUserId, bool IsMatch, Guid? ConversationId);
+public record LikesDto(IReadOnlyList<Guid> LikedUserIds, IReadOnlyList<Guid> IncomingUserIds);
+
+public record ProfileMetadata(
+    string? DisplayName = null, string City = "", string[]? Interests = null,
+    string? Sign = null, string[]? Photos = null, string[]? Goals = null);
+
+public static class UserMapping
+{
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+
+    public static ProfileMetadata Metadata(User user)
+    {
+        try { return JsonSerializer.Deserialize<ProfileMetadata>(user.Profile?.Metadata ?? "{}", JsonOptions) ?? new(); }
+        catch (JsonException) { return new(); }
+    }
+
+    public static string Serialize(ProfileMetadata metadata) => JsonSerializer.Serialize(metadata, JsonOptions);
+
+    public static UserDto ToUserDto(User user)
+    {
+        var metadata = Metadata(user);
+        return new(user.Id, user.Username, user.Email, metadata.DisplayName ?? user.Username,
+            user.Profile?.AvatarUrl, user.LastSeenAt);
+    }
+
+    public static ProfileDto ToProfileDto(User user)
+    {
+        var metadata = Metadata(user);
+        var profile = user.Profile;
+        int? age = null;
+        if (profile?.BirthDate is DateOnly birth)
+        {
+            var today = DateOnly.FromDateTime(DateTime.UtcNow);
+            age = today.Year - birth.Year;
+            if (birth.AddYears(age.Value) > today) age--;
+        }
+        return new(user.Id, user.Username, metadata.DisplayName ?? user.Username,
+            profile?.AvatarUrl, user.LastSeenAt, age, profile?.BirthDate,
+            metadata.City, profile?.Bio ?? "", metadata.Interests ?? [], metadata.Sign,
+            metadata.Photos ?? [], metadata.Goals ?? [], profile?.Gender);
+    }
+}
