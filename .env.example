# Backend URL for the LOCAL Vite proxy. This variable is not exposed in the browser.
# With compose.integration.yaml this is the published Nginx address, which proxies to API.
API_PROXY_TARGET=http://127.0.0.1:8080

# Optional: override browser endpoints only when API is on a separate HTTPS origin.
# By default Docker Nginx and Vite proxy both provide these same-origin paths.
VITE_API_BASE_URL=/api
VITE_HUB_URL=/hubs/chat
